# ==============================================================================
# BLX REALTY INVENTORY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Backend-only Supabase connection. These values are used exclusively by the
# Express server and must never be exposed through VITE_ prefixed variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Production CORS allow-list. Comma-separated, explicit origins only.
# Wildcard (*) is rejected in production.
# Example: ALLOWED_ORIGINS=https://blx-inventory.vercel.app,https://www.example.com
ALLOWED_ORIGINS=

# Runtime mode (Vercel sets this automatically)
NODE_ENV=development

# Local Development Port
PORT=5001